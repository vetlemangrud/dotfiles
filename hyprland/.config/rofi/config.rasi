@import "colors.rasi"

configuration { show-icons: true; }

window {
    width: 500px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
}
mainbox { background-color: transparent; padding: 12px; }
inputbar { background-color: @bg-alt; padding: 8px; border-radius: 8px; }
prompt, entry { background-color: transparent; text-color: @fg; }
listview { background-color: transparent; lines: 8; margin: 8px 0 0 0; }
element { padding: 6px; border-radius: 8px; background-color: transparent; text-color: @fg; }
element selected.normal { background-color: @accent; text-color: @accent-fg; }
element-text { background-color: transparent; text-color: inherit; }
