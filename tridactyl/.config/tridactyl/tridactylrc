" reload with :source

" wipe old state so this file is the single source of truth
sanitise tridactyllocal tridactylsync

" --- new tab: about:newtab is privileged, tridactyl is dead there ---
set newtab about:blank

" --- search ---
set searchengine kagi
set searchurls.gh    https://github.com/search?q=%s
set searchurls.mdn   https://developer.mozilla.org/search?q=%s
set searchurls.jira  https://sikri.atlassian.net/browse/%s

" --- hints ---
set hintchars asdfghjkl
set hintfiltermode vimperator-reflow
set hintnames short

set smoothscroll true
set allowautofocus false

" --- editor: Ctrl-i in a textbox opens nvim ---
set editorcmd kitty -e nvim %f "+normal!%lGzv%cl"

" --- binds ---
bind J tabprev
bind K tabnext
bind gd tabdetach
bind yy clipboard yank

" give native find back
unbind <C-f>

" --- sites where tridactyl must stay out of the way ---
blacklistadd mail.google.com
blacklistadd app.slack.com
